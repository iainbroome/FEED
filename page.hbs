{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- Everything inside the #post block pulls data from the page --}}
{{#page}}

{{#contentFor "sidebar-widgets"}}
	{{!-- Toc. --}}
	{{#if html}}
		{{#has tag="#toc"}}
			{{> "widgets/toc"}}
		{{/has}}
	{{/if}}

	{{!-- Subscribe. --}}
	{{> "widgets/subscribe"}}

	{{!-- Featured. --}}
	{{#get "posts" filter="featured:true" include="tags" limit="3"}}
		{{> "widgets/posts"}}
	{{/get}}

	{{!-- Tags. --}}
	{{#> "get-tags" setting=@custom.tags_list_widget}}
		{{> "widgets/tags"}}
	{{/"get-tags"}}

	{{!-- Recommendations. --}}
	{{> "widgets/recommendations"}}
{{/contentFor}}

<article class="post">
	{{> "sections/hero"}}

	{{!-- Content. --}}
	{{> "post/content"}}
</article>

{{/page}}

