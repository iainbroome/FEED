{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- Widgets (home, authors, tags). --}}
{{#contentFor "sidebar-widgets"}}
	{{!-- Subscribe. --}}
	{{> "widgets/subscribe"}}

	{{!-- Featured. --}}
	{{#get "posts" filter="featured:true" include="tags" limit="3"}}
		{{> "widgets/posts"}}
	{{/get}}

	{{!-- Recommendations. --}}
	{{> "widgets/recommendations"}}
{{/contentFor}}

{{!-- Everything inside the #page block pulls data from the page. --}}
{{#page}}
	<article class="post custom-page">
		{{!-- Hero. --}}
		{{> "sections/hero"}}

		{{!-- Tags. --}}
		{{#> "get-tags" setting=@custom.tags_page_displaying_tags}}
			{{#if tags}}
				<section class="section-tags">
					<h2 class="screen-reader-text">{{t "Tags List"}}</h2>

					<div class="section-tags-list">
						{{#foreach tags}}
							<div class="section-tags-card">
								<a href="{{url}}"></a>
								{{#if feature_image}}
									<figure>
										{{> "components/image" size="avatar" src=feature_image alt=name}}
									</figure>
								{{else}}
									<div{{#if accent_color}} style="--tag--color: {{accent_color}};"{{/if}}></div>
								{{/if}}

								<h3>{{name}}</h3>

								{{#if count.posts}}
									<span>{{plural count.posts empty='' singular=(t "% post") plural=(t "% posts")}}</span>
								{{/if}}
							</div>
						{{/foreach}}
					</div>
				</section>
			{{/if}}
		{{/"get-tags"}}

		{{!-- Content. --}}
		{{> "post/content"}}
	</article>
{{/page}}

