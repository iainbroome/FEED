{{#*inline "get-content-type"}}
	{{#if is_post}}
		{{> @partial-block content_type=(t "post")}}
	{{else}}
		{{> @partial-block content_type=(t "page")}}
	{{/if}}
{{/inline}}

<aside class="post-upgrade-cta" id="post-upgrade-cta">
	{{#> "get-content-type"}}
		{{#has visibility="paid"}}
			<h2>{{t "This {content_type} is for paying subscribers only" content_type=content_type}}</h2>
		{{else has visibility="members"}}
			<h2>{{t "This {content_type} is for subscribers only" content_type=content_type}}</h2>
		{{else has visibility="tiers"}}
			<h2>{{t "This {content_type} is for subscribers on the {tiers} only" content_type=content_type tiers=(tiers prefix="" suffix="")}}</h2>
		{{/has}}
	{{/"get-content-type"}}

	<p>{{t "Become a member now and have access to all posts, enjoy exclusive content, and stay updated with constant updates."}}</p>

	{{#if @member}}
		<a class="button" href="{{t "#/portal/account/plans"}}">{{t "Upgrade your account"}}</a>
	{{else}}
		<a class="button" href="{{t "#/portal/signup"}}">
			<span class="label">{{t "Become a member"}}</span>
		</a>
		<p>{{t "Already have an account?"}} <a href="{{t "#/portal/signin"}}">{{t "Sign in"}}</a></p>
	{{/if}}
</aside>