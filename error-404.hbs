{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#contentFor "title"}}{{statusCode}} — {{message}}{{/contentFor}}
{{#contentFor "body-class"}} page-error{{/contentFor}}

<div class="page-error-card">
	<h1>{{statusCode}}. {{message}}</h1>
	<p>{{t 'Ah, cripes. You have landed on a page that does not exist. It may have been deleted or it could be that the web address is wrong. Check that first.'}}</p>
	<p>{{t 'Still no luck? Try the following.'}}</p>
	<ul class="page-error-links">
		<li><a href="http://clearlanguage.club">{{t 'Back to the home page'}}</a></li>
		<li><a href="/tags">{{t 'Choose a tag'}}</a></li>
		<li><a href="#/search">{{t 'Use the site search'}}</a></li>
	</ul>
</div>
