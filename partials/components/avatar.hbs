{{#match name "anonymous"}}
	<span class="avatar">
		{{> "icons-menu/user"}}
	</span>
{{else match size "small"}}
	<span class="avatar avatar-small"{{#if name}} data-placeholder="{{name.[0]}}"{{/if}}>
		{{#if src}}{{> "components/image" class=false size="avatar-small" alt=name custom_attr=(concat 'data-placeholder="' name.[0] '"')}}{{/if}}
	</span>
{{else match size "author"}}
	<span class="avatar avatar-author"{{#if name}} data-placeholder="{{name.[0]}}"{{/if}}>
		{{#if src}}{{> "components/image" class=false size="avatar-author" alt=name custom_attr=(concat 'data-placeholder="' name.[0] '"')}}{{/if}}
	</span>
{{else}}
	<span class="avatar"{{#if name}} data-placeholder="{{name.[0]}}"{{/if}}>
		{{#if src}}{{> "components/image" class=false size="avatar" alt=name custom_attr=(concat 'data-placeholder="' name.[0] '"')}}{{/if}}
	</span>
{{/match}}