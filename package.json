{
	"name": "feed",
	"version": "2.0.0",
	"description": "A fast-paced, social media-style theme designed for tech news, startup updates, and digital innovation coverage.",
	"keywords": [
		"ghost",
		"theme",
		"ghost-theme"
	],
	"bugs": "https://github.com/priority-vision/feed/issues",
	"repository": {
		"type": "git",
		"url": "https://github.com/priority-vision/feed.git"
	},
	"author": {
		"name": "Priority Vision",
		"email": "support@priority.vision",
		"url": "https://www.priority.vision/"
	},
	"scripts": {
		"build": "rollup -c --environment BUILD:production",
		"build:prod": "npm run build && npm run translate && zippie feed.zip",
		"dev": "rollup -c --environment BUILD:development -w",
		"pretest": "npm run build",
		"test": "gscan .",
		"test:ci": "gscan --fatal --verbose .",
		"translate": "gtl c",
		"postversion": "node scripts/update-version.mjs",
		"version:major": "npm version major --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version"
	},
	"config": {
		"card_assets": true,
		"custom": {
			"color_scheme": {
				"type": "select",
				"options": [
					"Light",
					"Dark",
					"System"
				],
				"default": "System"
			},
			"display_color_scheme_toggle": {
				"type": "boolean",
				"default": true
			},
			"dark_mode_logo": {
				"type": "image"
			},
			"sections_style": {
				"type": "select",
				"options": [
					"Card",
					"Cloud",
					"Divided"
				],
				"default": "Divided"
			},
			"layout_style": {
				"type": "select",
				"options": [
					"Full",
					"Compact",
					"Navbar",
					"Navbar Clean",
					"Focused",
					"Minimal"
				],
				"default": "Full"
			},
			"post_card_style": {
				"type": "select",
				"options": [
					"Classic",
					"Classic Extended",
					"Classic Full",
					"Classic Minimal",
					"Classic Minimal Extended",
					"Classic Minimal Full",
					"List",
					"Grid"
				],
				"default": "Classic Extended"
			},
			"tags_list_widget": {
				"type": "text",
				"default": "5",
				"description": "Learn more here: https://www.priority.vision/docs/feed/settings-homepage/sections/#tags-section"
			},
			"tags_page_displaying_tags": {
				"type": "text",
				"default": "-1",
				"description": "Learn more here: https://www.priority.vision/docs/feed/settings-sitewide/tags/"
			},
			"footer_copyright": {
				"type": "text"
			}
		},
		"image_sizes": {
			"20": {
				"width": 20
			},
			"40": {
				"width": 40
			},
			"80": {
				"width": 80
			},
			"100": {
				"width": 100
			},
			"200": {
				"width": 200
			},
			"320": {
				"width": 320
			},
			"560": {
				"width": 560
			},
			"800": {
				"width": 800
			},
			"1100": {
				"width": 1100
			},
			"1300": {
				"width": 1300
			},
			"1600": {
				"width": 1600
			},
			"2000": {
				"width": 2000
			}
		},
		"posts_per_page": 6
	},
	"browserslist": [
		"defaults"
	],
	"dependencies": {
		"geist": "^1.2.2",
		"ivent": "^0.2.0",
		"throttle-debounce": "^5.0.0"
	},
	"devDependencies": {
		"@lehoczky/postcss-fluid": "^1.0.3",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@vercel/style-guide": "^6.0.0",
		"esbuild": "^0.25.2",
		"eslint": "^8.57.0",
		"eslint-plugin-prettier": "^5.2.6",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"ghost-theme-locales": "^0.0.4",
		"glob": "^11.0.1",
		"gscan": "^5.0.0",
		"postcss": "^8.5.3",
		"postcss-import": "^16.1.0",
		"postcss-mixins": "^11.0.3",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^10.1.5",
		"prettier": "^3.5.3",
		"rollup": "^4.39.0",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-livereload": "^2.0.5",
		"rollup-plugin-postcss": "^4.0.2",
		"stylelint": "^16.18.0",
		"stylelint-config-standard": "^38.0.0",
		"stylelint-order": "^7.0.0",
		"zippie": "^0.0.1"
	},
	"optionalDependencies": {
		"pvs": "github:priority-vision/pvs#v2.3.0"
	},
	"engines": {
		"ghost": ">=5.0.0"
	},
	"demo": "https://feed.priority.vision/",
	"docs": "https://www.priority.vision/docs/feed/",
	"gpm": {
		"type": "theme",
		"categories": [
			"Blog",
			"Personal",
			"Minimal",
			"Newsletter"
		]
	},
	"screenshots": {
		"desktop": "assets/screenshot-desktop.jpg"
	}
}
