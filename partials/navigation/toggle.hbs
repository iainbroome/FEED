{{!--
	Toggle collapse or dropdown.

	Variables:
		- nav: data included in {{navigation}}.
		- item: data included in the link.
		- this: all data.
 --}}

{{!-- Collapse. --}}
{{#if nav.collapse}}
	<button
		aria-expanded="false"
		class="collapse-toggle nav-link nav-link-{{item.slug}}{{#if item.current}} nav-link-current{{/if}}"
		aria-controls="{{concat "nav-" nav.id "-collapse-content-" item.slug "-" @index}}"
		id="{{concat "nav-" nav.id "-collapse-toggle-" item.slug "-" @index}}"
	>
		{{#unless nav.hide_icons}}{{#unless sub}}{{> "icons-menu/all" slug=item.slug}}{{/unless}}{{/unless}}
		<span class="label">{{item.label}}</span>
	</button>

	{{#if nav.sidebar}}
		{{!-- For collapsed sidebar. --}}
		{{> "navigation/link"}}
	{{/if}}

{{!-- Dropdown. --}}
{{else}}
	{{> "navigation/link"}}
	<button
		aria-expanded="false"
		class="dropdown-toggle"
		aria-controls="{{concat "nav-dropdown-content-" item.slug "-" @index}}"
		aria-label="{{t "Show {label} dropdown navigation" label=item.label}}"
		id="{{concat "nav-dropdown-toggle-" item.slug "-" @index}}"
	></button>
{{/if}}